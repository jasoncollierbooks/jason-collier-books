{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://collierentertainment.com",
          "https://www.collierentertainment.com",
          "https://jasoncollierbooks.github.io",
          "http://localhost:8000",
          "http://localhost:8080",
          "http://localhost:5500",
          "http://localhost:3000",
          "http://127.0.0.1:8000",
          "http://127.0.0.1:8080",
          "http://127.0.0.1:5500"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["Range"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "Accept-Ranges", "Content-Type", "ETag"],
      "maxAgeSeconds": 86400
    }
  ]
}
